  "prefetch_factor": 2,
  "tokenization_batch_size": 512,
  "tokenization_log_every": 50,
  "gradient_checkpointing": false,
  "symmetric_validation": true,
  "label_smoothing": 0.0,
  "max_grad_norm": 1.0,
  "log_every": 20,
  "seed": 42
}
