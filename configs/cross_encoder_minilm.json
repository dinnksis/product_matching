{
  "model": "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1",
  "epochs": 1,
  "batch_size": 96,
  "eval_batch_size": 192,
  "gradient_accumulation": 1,
  "learning_rate": 2e-5,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "max_length": 256,
  "attention_implementation": "sdpa",
