{
  "experiment": "minilm_serialization_ablation",
  "model": "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1",
  "variants": [
    "S0_TITLE",
    "S1_KEY_VALUE",
    "S2_VALUES_ONLY",
    "S3_HYBRID"
  ],
  "validation_fraction": 0.15,
  "split_seed": 42,
  "split_strategy": "brand_model_family_holdout",
  "train_subset_size": 120000,
  "train_subset_seed": 20260814,
  "hybrid_frequency": {
    "strategy": "occurrence_coverage",
    "target_coverage": 0.8,
    "minimum_item_support": 100,
    "maximum_frequent_keys": 1024
  },
  "epochs": 1,
  "batch_size": 64,
  "eval_batch_size": 192,
  "gradient_accumulation": 1,
  "learning_rate": 2e-5,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "max_length": 256,
  "attention_implementation": "sdpa",
  "bucket_size_multiplier": 50,
  "dataloader_workers": 2,
  "prefetch_factor": 2,
  "tokenization_batch_size": 512,
  "tokenization_log_every": 50,
  "gradient_checkpointing": false,
  "symmetric_validation": true,
  "label_smoothing": 0.0,
  "max_grad_norm": 1.0,
  "log_every": 50,
  "parallel_runs": 2,
  "seed": 42
}
