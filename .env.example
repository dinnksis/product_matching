# Copy to .env and paste the token generated at https://www.kaggle.com/settings/api.
KAGGLE_API_TOKEN=

# Kaggle profile slug, as it appears in kaggle.com/<username>.
KAGGLE_USERNAME=

# The notebook is pushed as https://www.kaggle.com/code/<username>/<slug>.
KAGGLE_KERNEL_SLUG=product-matching-training
KAGGLE_KERNEL_TITLE=Product Matching Training

# Kaggle resource refs, comma-separated. Leave empty when not needed.
# Dataset example: owner/dataset-slug
# Competition example: competition-slug
KAGGLE_DATASET_SOURCES=
KAGGLE_COMPETITION_SOURCES=
KAGGLE_KERNEL_SOURCES=
KAGGLE_MODEL_SOURCES=

# Private notebooks automatically attach
# <KAGGLE_USERNAME>/ecom-matching-google-sheets-credentials.
# Override only when the credential Dataset belongs to another owner:
# KAGGLE_GOOGLE_SHEETS_CREDENTIALS_DATASET=owner/dataset-slug

# Local/server validation runs can use the same service account. Never commit
# the JSON key itself. The launcher also checks secrets/google-service-account.json.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
EXPERIMENT_SPREADSHEET_ID=1CtqT52XOrFyHfFt6rCiOMlnq6snJMlsMOJ0ubH79ikA

# Training defaults: Kaggle's T4 profile, internet enabled, private notebook.
KAGGLE_ACCELERATOR=NvidiaTeslaT4
KAGGLE_ENABLE_INTERNET=true
KAGGLE_IS_PRIVATE=true

# Kaggle sessions are limited; this requests at most 12 hours and waits locally.
KAGGLE_RUN_TIMEOUT_SECONDS=43200
KAGGLE_WAIT_TIMEOUT_SECONDS=45000
KAGGLE_POLL_INTERVAL_SECONDS=30
KAGGLE_OUTPUT_DIR=artifacts/kaggle
