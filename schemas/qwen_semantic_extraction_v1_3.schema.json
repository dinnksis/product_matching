{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen_semantic_extraction_v1_3.schema.json",
  "title": "Qwen unified semantic product-pair extraction v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_facts"],
  "properties": {
    "semantic_facts": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/semantic_fact" }
    }
  },
  "$defs": {
    "concept": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "anchor_type": {
      "type": "string",
      "enum": [
        "exact_sku",
        "manufacturer_part_number",
        "exact_model",
        "model_family",
        "product_line",
        "brand",
        "other_identity"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "raw_attribute_name", "raw_fragment"],
      "properties": {
        "source": { "type": "string", "enum": ["title", "attribute"] },
        "raw_attribute_name": { "type": ["string", "null"], "maxLength": 300 },
        "raw_fragment": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "semantic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "normalized_value", "unit"],
      "properties": {
        "raw_value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "normalized_value": { "type": ["string", "null"], "maxLength": 200 },
        "unit": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": { "$ref": "#/$defs/semantic_value" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "conflicted_side": {
      "allOf": [
        { "$ref": "#/$defs/side" },
        {
          "properties": {
            "evidence": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      ]
    },
    "semantic_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "relation",
        "anchor_type",
        "a",
        "b",
        "direction",
        "confidence"
      ],
      "properties": {
        "concept": { "$ref": "#/$defs/concept" },
        "relation": {
          "type": "string",
          "enum": [
            "identity_same",
            "different_value",
            "missing_a",
            "missing_b",
            "compatible",
            "incompatible",
            "subset",
            "more_specific",
            "conflicting_sources",
            "unknown"
          ]
        },
        "anchor_type": {
          "oneOf": [{ "$ref": "#/$defs/anchor_type" }, { "type": "null" }]
        },
        "a": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
        "b": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
        "direction": {
          "enum": [null, "a_to_b", "b_to_a", "item_a", "item_b"]
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "oneOf": [
        {
          "properties": {
            "relation": { "const": "identity_same" },
            "anchor_type": { "$ref": "#/$defs/anchor_type" },
            "a": { "$ref": "#/$defs/side" },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "const": null }
          }
        },
        {
          "properties": {
            "relation": { "const": "missing_a" },
            "anchor_type": { "const": null },
            "a": { "const": null },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "const": null }
          }
        },
        {
          "properties": {
            "relation": { "const": "missing_b" },
            "anchor_type": { "const": null },
            "a": { "$ref": "#/$defs/side" },
            "b": { "const": null },
            "direction": { "const": null }
          }
        },
        {
          "properties": {
            "relation": {
              "enum": ["different_value", "compatible", "incompatible", "unknown"]
            },
            "anchor_type": { "const": null },
            "a": { "$ref": "#/$defs/side" },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "const": null }
          }
        },
        {
          "properties": {
            "relation": { "enum": ["subset", "more_specific"] },
            "anchor_type": { "const": null },
            "a": { "$ref": "#/$defs/side" },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "enum": ["a_to_b", "b_to_a"] }
          }
        },
        {
          "properties": {
            "relation": { "const": "conflicting_sources" },
            "anchor_type": { "const": null }
          },
          "oneOf": [
            {
              "properties": {
                "a": { "$ref": "#/$defs/conflicted_side" },
                "b": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
                "direction": { "const": "item_a" }
              }
            },
            {
              "properties": {
                "a": { "oneOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
                "b": { "$ref": "#/$defs/conflicted_side" },
                "direction": { "const": "item_b" }
              }
            }
          ]
        }
      ]
    }
  }
}
