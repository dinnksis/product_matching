{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen_atomic_differences_v2.schema.json",
  "title": "Qwen atomic product-pair differences v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_facts"],
  "properties": {
    "semantic_facts": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/semantic_fact" }
    }
  },
  "$defs": {
    "concept": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "raw_attribute_name", "raw_fragment"],
      "properties": {
        "source": { "type": "string", "enum": ["title", "attribute"] },
        "raw_attribute_name": { "type": ["string", "null"], "maxLength": 300 },
        "raw_fragment": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "semantic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "normalized_value", "unit"],
      "properties": {
        "raw_value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "normalized_value": { "type": ["string", "null"], "maxLength": 200 },
        "unit": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": { "$ref": "#/$defs/semantic_value" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "semantic_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "relation",
        "anchor_type",
        "a",
        "b",
        "direction",
        "confidence"
      ],
      "properties": {
        "concept": { "$ref": "#/$defs/concept" },
        "relation": {
          "type": "string",
          "enum": [
            "different_value",
            "compatible",
            "incompatible",
            "subset",
            "more_specific"
          ]
        },
        "anchor_type": { "const": null },
        "a": { "$ref": "#/$defs/side" },
        "b": { "$ref": "#/$defs/side" },
        "direction": {
          "enum": [null, "a_to_b", "b_to_a", "item_a", "item_b"]
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "oneOf": [
        {
          "properties": {
            "relation": {
              "enum": ["different_value", "compatible", "incompatible"]
            },
            "a": { "$ref": "#/$defs/side" },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "const": null }
          }
        },
        {
          "properties": {
            "relation": { "enum": ["subset", "more_specific"] },
            "a": { "$ref": "#/$defs/side" },
            "b": { "$ref": "#/$defs/side" },
            "direction": { "enum": ["a_to_b", "b_to_a"] }
          }
        }
      ]
    }
  }
}
